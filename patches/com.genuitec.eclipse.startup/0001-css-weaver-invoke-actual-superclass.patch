-      mv.visitMethodInsn(183, "org/eclipse/e4/ui/css/swt/engine/AbstractCSSSWTEngineImpl", "applyStyles", "(Ljava/lang/Object;Z)V", false);
+      // super.applyStyles(...): invoke on the woven class's actual superclass rather
+      // than a hardcoded name. Eclipse 2026-09 (4.41) removed AbstractCSSSWTEngineImpl
+      // (CSSSWTEngineImpl now extends CSSEngineImpl directly); INVOKESPECIAL resolves
+      // the inherited method either way, so this works on every release.
+      mv.visitMethodInsn(183, cw.superName, "applyStyles", "(Ljava/lang/Object;Z)V", false);
       Label l13 = new Label();
