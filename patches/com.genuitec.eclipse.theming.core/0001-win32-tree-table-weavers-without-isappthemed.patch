+package com.genuitec.eclipse.theming.core.internal.extensions;
+
+import org.objectweb.asm.tree.ClassNode;
+
+/**
+ * revstyle shim for Eclipse 2026-09 (SWT 3.135) and later: FixTable202409's
+ * emitted copy of Table.sendEraseItemEvent calls the OS.IsAppThemed() native
+ * that SWT 3.135 removed. Same treatment as FixTree202609.
+ */
+public class FixTable202609 extends FixTable202409 {
+   @Override
+   protected void weave(ClassNode cw) {
+      super.weave(cw);
+      FixTree202609.dropIsAppThemed(cw, "sendEraseItemEvent");
+   }
+}
